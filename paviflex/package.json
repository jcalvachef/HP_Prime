{
  "name": "paviflex",
  "private": true,
  "version": "1.2.0",
  "description": "Inspección visual de pavimentos flexibles (metodología INVIAS) para Android",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.5",
    "@capacitor/share": "^8.0.3",
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "pdfmake": "^0.3.15",
    "proj4": "^2.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/pdfmake": "^0.3.3",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jpeg-js": "^0.4.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
